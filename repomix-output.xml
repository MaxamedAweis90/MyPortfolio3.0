          </p>
        </motion.div>

        {/* Main Content: Info Hub (Left) & Request Form (Right) */}
        <div className="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">
          {/* Left Column: Direct Info & Quick Action Cards (5 Columns) */}
          <motion.div
