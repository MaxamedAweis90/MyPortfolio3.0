      const result = await res.json();

      if (res.ok && result.success) {
        setIsSuccess(true);
        toast.success("🚀 Proposal sent successfully!", {
          position: "top-center",
          autoClose: 3000,
          hideProgressBar: false,
          theme: "dark",
        });
      } else {
        throw new Error(result.error || "Unknown error");
      }
    } catch (err) {
      console.error("Form submission error:", err);
