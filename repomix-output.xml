@tailwind base;
@tailwind components;
@tailwind utilities;

/* =============================================
   THEME TOKENS — Dark mode (mytheme) = DEFAULT
   ============================================= */
:root,
[data-theme="mytheme"],
[data-theme="dark"] {
  --color-mainBg: #11161d;
  --color-surface: #1d2631;
  --color-borderSubtle: #2c394b;
  --color-primaryText: #e2e8f0;
  --color-mutedText: #94a3b8;
}

/* Light mode — all tokens flip */
[data-theme="light"] {
  --color-mainBg: #f1f5f9;
  --color-surface: #ffffff;
  --color-borderSubtle: #cbd5e1;
  --color-primaryText: #0f172a;
  --color-mutedText: #475569;
}

/* =============================================
   LIGHT MODE — Override Tailwind compiled utilities
   Tailwind bakes in static hex at build time, so we
   need CSS-level overrides scoped to data-theme=light
   ============================================= */
[data-theme="light"] .bg-mainBg {
  background-color: #f1f5f9 !important;
}
[data-theme="light"] .bg-surface {
  background-color: #ffffff !important;
}
[data-theme="light"] .text-primaryText {
  color: #0f172a !important;
}
[data-theme="light"] .text-mutedText {
  color: #475569 !important;
}
[data-theme="light"] .border-borderSubtle {
  border-color: #cbd5e1 !important;
}

/* Opacity-modified variants */
[data-theme="light"] .bg-surface\/85 {
  background-color: rgba(255, 255, 255, 0.85) !important;
}
[data-theme="light"] .bg-surface\/90 {
  background-color: rgba(255, 255, 255, 0.9) !important;
}
[data-theme="light"] .bg-surface\/95 {
  background-color: rgba(255, 255, 255, 0.95) !important;
}
[data-theme="light"] .bg-surface\/98 {
  background-color: rgba(255, 255, 255, 0.98) !important;
}
[data-theme="light"] .bg-mainBg\/80 {
  background-color: rgba(241, 245, 249, 0.8) !important;
}
[data-theme="light"] .bg-mainBg\/90 {
  background-color: rgba(241, 245, 249, 0.9) !important;
}
[data-theme="light"] .bg-mainBg\/95 {
  background-color: rgba(241, 245, 249, 0.95) !important;
}
[data-theme="light"] .border-borderSubtle\/50 {
  border-color: rgba(203, 213, 225, 0.5) !important;
}
[data-theme="light"] .border-borderSubtle\/60 {
  border-color: rgba(203, 213, 225, 0.6) !important;
}
[data-theme="light"] .border-borderSubtle\/80 {
  border-color: rgba(203, 213, 225, 0.8) !important;
}
[data-theme="light"] .text-primaryText\/90 {
  color: rgba(15, 23, 42, 0.9) !important;
}
[data-theme="light"] .text-mutedText\/80 {
  color: rgba(71, 85, 105, 0.8) !important;
}
[data-theme="light"] .text-mutedText\/90 {
  color: rgba(71, 85, 105, 0.9) !important;
}

/* Ring color (used on timeline nodes) */
[data-theme="light"] .ring-mainBg {
  --tw-ring-color: #f1f5f9 !important;
}

/* Body + html background */
[data-theme="light"] body,
[data-theme="light"] html {
  background-color: #f1f5f9;
  color: #0f172a;
}

/* =============================================
   WHOLE-APP THEME SWITCH ANIMATION
   - Switching to Dark Mode: Circular wipe from TOP-RIGHT (Toggle Button)
   - Switching to Light Mode: Circular wipe in reverse from BOTTOM-LEFT
   ============================================= */
::view-transition-old(root),
::view-transition-new(root) {
  animation: none;
  mix-blend-mode: normal;
}

::view-transition-old(root) {
  z-index: 1;
}

/* Default / fallback wipe */
::view-transition-new(root) {
  z-index: 999999;
  animation: theme-wipe-top-right 2.15s cubic-bezier(0.25, 1, 0.5, 1);
}

/* 1. Switching to DARK MODE: Wipe expands from Top-Right (near toggle button) */
[data-theme-transition="to-dark"]::view-transition-new(root) {
  z-index: 999999;
  animation: theme-wipe-top-right 2.15s cubic-bezier(0.25, 1, 0.5, 1);
}

@keyframes theme-wipe-top-right {
  0% {
    clip-path: circle(0% at 90% 40px);
  }
  100% {
    clip-path: circle(160% at 90% 40px);
  }
}

/* 2. Switching to LIGHT MODE: Wipe expands in reverse from Bottom-Left */
[data-theme-transition="to-light"]::view-transition-new(root) {
  z-index: 999999;
  animation: theme-wipe-bottom-left 1.15s cubic-bezier(0.25, 1, 0.5, 1);
}

@keyframes theme-wipe-bottom-left {
  0% {
    clip-path: circle(0% at 0% 100%);
  }
  100% {
    clip-path: circle(160% at 0% 100%);
  }
}

/* Smooth color fallback for elements */
body,
section,
nav {
  transition:
    background-color 0.35s ease,
    border-color 0.35s ease;
}

/* Automatically apply .cursor-target styles to all buttons */
button {
  /* This lets GSAP detect it as a cursor-target */
  position: relative; /* ensure layout behaves well */
}

button::before {
  content: "";
  display: none; /* just to show it could be customized */
}

/* Let the custom cursor system target buttons */
button.cursor-target,
button {
  /* optional: add a style hook if needed */
}

/* Tooltip */

.tooltip-container {
  position: relative;
  display: inline-block;
  cursor: pointer;
}

/* Initially, position the tooltip slightly above its final drop-down position */
.tooltip {
  position: absolute;
  top: 100%; /* places it below the link */
  left: 50%;
  transform: translateX(-50%) translateY(-10px);
  background: #333;
  color: #fff;

  /* WhatsApp-like thin scrollbar for chat areas */
  .scrollbar-whatsapp {
    scrollbar-width: thin; /* Firefox */
    scrollbar-color: rgba(0, 0, 0, 0.25) transparent;
  }
  .scrollbar-whatsapp::-webkit-scrollbar {
    width: 6px;
  }
  .scrollbar-whatsapp::-webkit-scrollbar-track {
    background: transparent;
  }
  .scrollbar-whatsapp::-webkit-scrollbar-thumb {
    background-color: rgba(0, 0, 0, 0.25);
    border-radius: 9999px;
  }
  @media (max-width: 640px) {
    /* Hide scrollbar on small screens for a cleaner mobile look */
    .scrollbar-whatsapp {
      scrollbar-width: none;
    }
    .scrollbar-whatsapp::-webkit-scrollbar {
      display: none;
    }
  }
  padding: 6px 10px;
  border-radius: 5px;
  font-size: 14px;
  white-space: nowrap;
  opacity: 0;
  visibility: hidden;
  box-shadow: 0px 4px 10px rgba(0, 0, 0, 0.2);
}

/* Tooltip arrow pointing upward toward the link */
.tooltip::after {
  content: "";
  position: absolute;
  top: -12px;
  left: 50%;
  transform: translateX(-50%);
  border-width: 6px;
  border-style: solid;
  border-color: transparent transparent #333 transparent;
}

/* Keyframe for the drop-down effect */
@keyframes dropDown {
  from {
    transform: translateX(-50%) translateY(-10px);
    opacity: 0;
  }
  to {
    transform: translateX(-50%) translateY(0);
    opacity: 1;
  }
}

/* Keyframe for the shake effect */
@keyframes shake {
  0% {
    transform: translateX(-50%) translateY(0) rotate(0deg);
  }
  25% {
    transform: translateX(-50%) translateY(0) rotate(7deg);
  }
  50% {
    transform: translateX(-50%) translateY(0) rotate(-7deg);
  }
  75% {
    transform: translateX(-50%) translateY(0) rotate(1deg);
  }
  100% {
    transform: translateX(-50%) translateY(0) rotate(0deg);
  }
}

/* On hover: first drop down then shake */
.tooltip-container:hover .tooltip {
  opacity: 1;
  visibility: visible;
  animation:
    dropDown 0.3s ease-out forwards,
    shake 0.5s ease-in-out 0.3s forwards;
}

body {
  width: 100%;
  height: 100%;
  --color: rgba(44, 57, 75, 0.25);
  background-color: #11161d;
  color: #e2e8f0;
  background-image:
    linear-gradient(
      0deg,
      transparent 24%,
      var(--color) 25%,
      var(--color) 26%,
      transparent 27%,
      transparent 74%,
      var(--color) 75%,
      var(--color) 76%,
      transparent 77%,
      transparent
    ),
    linear-gradient(
      90deg,
      transparent 24%,
      var(--color) 25%,
      var(--color) 26%,
      transparent 27%,
      transparent 74%,
      var(--color) 75%,
      var(--color) 76%,
      transparent 77%,
      transparent
    );
  background-size: 50px 50px;
}

/* Hide the native browser cursor on body */
body {
  cursor: none;
}

/* Restore standard browser cursors on Navbar elements */
nav,
nav *,
header,
header * {
  cursor: auto !important;
}
nav a,
nav button,
nav [role="button"],
header a,
header button {
  cursor: pointer !important;
}

/* Smooth Natural Left & Right Waving Animation for Hand Emoji */
.animate-wave {
  display: inline-block;
  transform-origin: 75% 75%;
  animation: wave-hand 2.5s ease-in-out infinite;
}

@keyframes wave-hand {
  0% {
    transform: rotate(0deg);
  }
  15% {
    transform: rotate(18deg);
  }
  30% {
    transform: rotate(-12deg);
  }
  45% {
    transform: rotate(18deg);
  }
  60% {
    transform: rotate(-6deg);
  }
  75% {
    transform: rotate(12deg);
  }
  85% {
    transform: rotate(0deg);
  }
  100% {
    transform: rotate(0deg);
  }
}

/* Main custom cursor styling using CSS custom properties for positioning */
.custom-cursor {
  position: fixed;
  pointer-events: none;
  width: 20px;
  height: 20px;
  left: var(--cursor-x, 0);
  top: var(--cursor-y, 0);
  background: radial-gradient(
    circle,
    rgba(255, 165, 0, 1) 0%,
    rgba(255, 69, 0, 1) 60%,
    transparent 70%
  );
  border-radius: 50%;
  transform: translate(-50%, -50%);
  transition:
    width 0.2s,
    height 0.2s,
    background 0.2s;
  z-index: 9999;
}

/* Cursor appearance when hovering over clickable elements */
.custom-cursor.hover {
  background: #fff;
  width: 60px;
  height: 60px;
  backdrop-filter: grayscale(1);
  mix-blend-mode: difference;
  pointer-events: none;
  cursor: none;
  zoom: 1;
}

/* Tail styling for a flame-like trailing effect */
.cursor-tail {
  position: fixed;
  pointer-events: none;
  width: 10px;
  height: 10px;
  background: radial-gradient(
    circle,
    rgba(255, 140, 0, 0.8) 0%,
    rgba(255, 69, 0, 0.5) 70%,
    transparent 100%
  );
  border-radius: 50%;
  transform: translate(-50%, -50%);
  z-index: 9998;
}

