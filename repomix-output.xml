  width: 80%; /* Match the text width */
  height: 30px;
  background-color: #fef3c7; /* Customize the color */
  bottom: -10px; /* Adjust vertical position */
  left: 50%;
  transform: translateX(-50%); /* Center under the text */
  z-index: -1; /* Place behind the header */
  border-radius: 5px; /* Optional: Adds rounded corners */
  border-color: #fef3c7;
  /* Shadow effect */
  --tw-shadow: 0px 10px 20px rgba(0, 0, 0, 0.2);
  --tw-shadow-colored: 0px 10px 20px var(--tw-shadow-color);
  box-shadow:
    var(--tw-ring-offset-shadow, 0 0 #0000), var(--tw-ring-shadow, 0 0 #0000),
    var(--tw-shadow);
}

/* 🌟 Footer */
.footer {
  background: var(--color-surface);
  border-top: 1px solid var(--color-borderSubtle);
  color: var(--color-primaryText);
}

[data-theme="light"] .footer {
  background-color: #ffffff !important;
  border-top: 1px solid #cbd5e1 !important;
  color: #0f172a !important;
}

@media screen and (max-width: 818px) {
  .custom-cursor {
    display: none;
  }

  .cursor-tail {
    display: none;
  }

  body {
    cursor: default;
  }
}

@media screen and (max-width: 520px) {
  .footer .socials {
    display: grid;
    grid-template-columns: 1fr; /* Ensures one column */
    gap: 10px; /* Adjust space between links */
    text-align: left; /* Aligns text inside links to the left */
    justify-items: start; /* Ensures the links are aligned to the left */
  }

  .footer .socials a {
    font-size: small;
  }
}

/* Scroll down style */
.scroll-container {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-top: 0px;
}

@media screen and (max-width: 818px) {
  .scroll-container {
    display: none;
  }
}

.mouse {
  --color: black;
  width: 30px;
  height: 50px;
  border: 3px solid var(--color);
  border-radius: 25px;
  position: relative;
  box-sizing: border-box;
  margin-bottom: 12px;
}

.scroll-ball {
  position: absolute;
  top: 10px;
  left: 50%;
  width: 6px;
  height: 6px;
  margin-left: -3px;
  background-color: var(--color);
  border-radius: 50%;
  animation: scroll-ball-move 2s infinite;
  box-shadow: 0px -5px 3px 1px #2a547066;
}

@keyframes scroll-ball-move {
  0% {
    opacity: 0;
    height: 6px;
    top: 10px;
  }
  40% {
    opacity: 1;
    height: 10px;
  }
  80% {
    opacity: 0;
    top: 30px;
    height: 10px;
  }
  100% {
    opacity: 0;
    height: 3px;
  }
}

.chevrons {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-top: 0px;
}

.chevrondown {
  border: solid var(--color);
  border-width: 0 3px 3px 0;
  width: 10px;
  height: 10px;
  transform: rotate(45deg);
  margin-top: 0px;
  animation: chevron-pulse 500ms ease infinite alternate;
}

.chevrondown:nth-child(2) {
  animation-delay: 250ms;
}

@keyframes chevron-pulse {
  from {
    opacity: 0;
  }
  to {
    opacity: 0.5;
  }
}

/* globals.css */
.scrollbar-hide::-webkit-scrollbar {
  display: none;
}
.scrollbar-hide {
  -ms-overflow-style: none; /* IE and Edge */
  scrollbar-width: none; /* Firefox */
}

.scrollbar-screenshots {
  scrollbar-width: none;
}

.scrollbar-screenshots::-webkit-scrollbar {
  display: none;
}

@media (min-width: 768px) {
  .scrollbar-screenshots {
    scrollbar-width: thin;
    scrollbar-color: rgba(2, 129, 220, 0.45) transparent;
  }

  .scrollbar-screenshots::-webkit-scrollbar {
    display: block;
    height: 6px;
  }

  .scrollbar-screenshots::-webkit-scrollbar-track {
    background: transparent;
  }

  .scrollbar-screenshots::-webkit-scrollbar-thumb {
    background-color: rgba(2, 129, 220, 0.45);
    border-radius: 9999px;
  }
}

/* Infinite Looping Tech Marquee Animations */
@keyframes marquee-left {
  0% {
    transform: translateX(0%);
  }
  100% {
    transform: translateX(-50%);
  }
}

@keyframes marquee-right {
  0% {
    transform: translateX(-50%);
  }
  100% {
    transform: translateX(0%);
  }
}

.animate-marquee-left {
  animation: marquee-left 45s linear infinite;
  will-change: transform;
}

.animate-marquee-right {
  animation: marquee-right 45s linear infinite;
  will-change: transform;
}
