          >
            {/* Live Status Card */}
            <div className="p-5 sm:p-6 rounded-3xl bg-surface/90 backdrop-blur-md border border-borderSubtle shadow-xl space-y-3 relative overflow-hidden group hover:border-emerald-500/40 transition-all">
