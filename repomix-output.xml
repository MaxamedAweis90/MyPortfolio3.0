<file path="src/app/styles/services.css">
/* ---------------------------
   Flip Card + Waves + Blur
---------------------------- */

.cards {
  display: flex;
  flex-wrap: wrap;
  gap: 18px;
  justify-content: center;
  padding: 0;
  margin: 0;
}

/* Move bg color here */
.flip-front.red,
.flip-back.red { background-color: #f43f5e; }

.flip-front.blue,
.flip-back.blue { background-color: #3b82f6; }

.flip-front.green,
.flip-back.green { background-color: #22c55e; }

.flip-front.purple,
.flip-back.purple { background-color: #8b5cf6; }

/* Remove bg from .card itself */
.cards .card {
  background-color: transparent; /* REMOVE ANY PREVIOUS COLOR */
}

.cards .card {
  width: 340px;
  height: 230px;
  border-radius: 10px;
  color: white;
  cursor: pointer;
  position: relative;
  overflow: hidden;
  transition: transform 0.4s ease, filter 0.3s ease;
  transform-style: preserve-3d;
  perspective: 1000px;
  margin: 0;
  padding: 0;
  flex-shrink: 0;
}

.cards .card:hover {
  transform: scale(1.05);
}
.cards:has(.card:hover) > .card:not(:hover) {
  filter: blur(8px);
  transform: scale(0.92);
}

.flip-enabled {
  transform-style: preserve-3d;
  transition: transform 0.6s ease;
}

.flip-enabled:hover {
  transform: rotateY(180deg) scale(1.05);
}

.flip-front,
.flip-back {
  backface-visibility: hidden;
  -webkit-backface-visibility: hidden;
  position: absolute;
  width: 100%;
  height: 100%;
  border-radius: 10px;
  overflow: hidden;
  top: 0;
  left: 0;
}

.flip-front {
  z-index: 2;
}

.flip-back {
  transform: rotateY(180deg);
  background-color: #111827;
  color: white;
  display: flex;
  flex-direction: column;
  justify-content: center;
  align-items: center;
  padding: 2rem;
  text-align: center;
  z-index: 1;
}

/* ---------------------------
   Animated Wave Background
---------------------------- */

.e-card {
  background: transparent;
  box-shadow: 0px 8px 28px -9px rgba(0, 0, 0, 0.45);
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  overflow: hidden;
}

.wave {
  position: absolute;
  width: 540px;
  height: 700px;
  opacity: 0.6;
  left: 0;
  top: 0;
  margin-left: -30%;
  margin-top: 10%;
  background: linear-gradient(744deg, #7d7583, #505a41 60%, #251155);
  border-radius: 40%;
  animation: wave 55s infinite linear;
}

.playing .wave:nth-child(2) {
  animation-duration: 4000ms;
}
.wave:nth-child(2) {
  animation-duration: 50s;
}
.playing .wave:nth-child(3) {
  animation-duration: 5000ms;
}
.wave:nth-child(3) {
  animation-duration: 45s;
}

@keyframes wave {
  0% {
    transform: rotate(0deg);
  }
  100% {
    transform: rotate(360deg);
  }
}

/* ---------------------------
   Icon + Text
---------------------------- */

.icon {
  width: 100%;
  margin-top: -1.5em;
  font-size: 3rem;
}

.infotop {
  text-align: center;
  font-size: 20px;
  position: absolute;
  padding: 0 12px;
  top: 6em;
  left: 0;
  right: 0;
  color: #fff;
  font-weight: 600;
}

.name {
  font-size: 14px;
  font-weight: 100;
  position: relative;
  top: 1em;
  text-transform: lowercase;
}

/* ---------------------------
   Flip Back Text
---------------------------- */

.flip-back h4 {
  font-size: 1.25rem;
  margin-bottom: 0.5rem;
}

.flip-back p {
  font-size: 0.9rem;
  opacity: 0.85;
  line-height: 1.4;
}

/* ---------------------------
   Responsive
---------------------------- */

@media screen and (max-width: 818px) {
  .cards {
    flex-direction: column;
    gap: 15px;
  }
}


.cards .card {
  width: 340px;
  height: 230px;
  border-radius: 10px;
  perspective: 1000px;
  position: relative;
  margin: 0;
  padding: 0;
  flex-shrink: 0;
}

.flip-inner {
  width: 100%;
  height: 100%;
  position: relative;
  transform-style: preserve-3d;
  transition: transform 0.6s ease;
}

.card:hover .flip-inner {
  transform: rotateY(180deg);
}

.flip-front,
.flip-back {
  position: absolute;
  width: 100%;
  height: 100%;
  border-radius: 10px;
  backface-visibility: hidden;
  -webkit-backface-visibility: hidden;
  overflow: hidden;
}

.flip-front {
  z-index: 2;
}

.flip-back {
  background-color: #111827;
  color: white;
  transform: rotateY(180deg);
  display: flex;
  justify-content: center;
  align-items: center;
  flex-direction: column;
  text-align: center;
  padding: 2rem;
  z-index: 1;
}
