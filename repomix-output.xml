<file path="src/app/styles/hero.css">
/* Add this to your globals.css */
@import url('https://fonts.googleapis.com/css2?family=Zilla+Slab+Highlight:wght@400;700&display=swap');

.lobster-two-font {
  font-family: "Zilla Slab Highlight", serif;
}


/* Flip Effect */
.flip-container {
  perspective: 1000px;
}

.flip-card {
  position: relative;
  width: 100%;
  height: 100%;
  transform-style: preserve-3d;
  transition: transform 0.4s ease-in-out;
}

.flip-card-front,
.flip-card-back {
  position: absolute;
  width: 100%;
  height: 100%;
  top: 0;
  left: 0;
  backface-visibility: hidden;
  display: flex;
  align-items: center;
  justify-content: center;
}

.flip-card-back {
  transform: rotateY(180deg);
}

.hero-image {
  width: 800px;
  height: 800px;
  object-position: center;
  transition: transform 0.3s ease-in-out;
}

/* Reduce Hover Sensitivity */
.flip-container:hover .hero-image {
  transform: scale(1.02);
}

/* Responsive Adjustments */
@media screen and (max-width: 768px) {
  .flip-container {
    max-width: 600px !important;
    height: 600px !important;
  }

  .hero {
    padding-top: 2rem;
    padding-bottom: 2rem;
  }

  .hero-image {
    width: 600px;
    height: 600px;
    object-position: center;
  }

  .info {
    padding: 0 1rem;
    align-items: start;

  }
}

@media screen and (max-width: 480px) {
  .hero-image {
    width: 500px;
    height: 500px;
    object-position: center;
  }
}
</file>

<file path="src/app/styles/socials.css">
.card {
    display: flex;
    width: 220px;
    height: 50px;
    background-color: rgb(255, 255, 255);
    border-radius: 115px;
    padding-inline: 15px;
    position: relative;
    justify-content: space-around;
  }
  
  .social-icons {
    cursor: pointer;
    display: flex;
    transition: all 0.5s;
    align-items: center;
    justify-content: center;
    position: relative;
    color: white;
    font-weight: bold;
    font-size: small;
  }
  
  /* Tooltip label (kept as originally styled) */
  .social-label {
    --var: -0%;
    position: absolute;
    bottom: var(--var);
    width: max-content;
    transition: all 0.7s;
    opacity: 0;
    padding-inline: 7px;
    padding-block: 2px;
    border-radius: 7px;
  }
  
  .social-label::after {
    content: "";
    position: absolute;
    border-bottom: 10px solid crimson;
    border-left: 7px solid transparent;
    border-right: 7px solid transparent;
    bottom: 100%;
    left: 50%;
    transform: translate(-50%);
  }
  
  /* Show the tooltip on hover */
  .social-icons:hover .social-label {
    --var: -65%;
    opacity: 1;
  }
  
  .social-icons:hover {
    z-index: 15;
  }
  
  .card:hover > .social-icons:not(:hover) {
    filter: blur(3px);
    transform: scale(0.8);
  }
  
  /* Ensure the clickable icon isn’t affected by tooltip styles */
  .social-link {
    text-decoration: none;
  }
  
  .card svg {
    height: 30px;
  }
</file>

